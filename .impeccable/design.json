  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The ruled action: 2px ink border with a 4px bottom rule, never filled.",
      "html": "<button class=\"ds-btn-primary\">Guardar</button>",
      "css": ".ds-btn-primary{background:var(--paper);color:var(--ink);font-family:var(--font-sans);min-height:44px;padding:0 20px;font-size:1rem;border-radius:0;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:transform 150ms ease-out,background-color 150ms ease-out;border:2px solid var(--ink);border-bottom-width:4px;font-weight:600}.ds-btn-primary:hover{background:var(--surface)}.ds-btn-primary:active{transform:scale(0.98)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}@media (prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet alternative action on a Marked Rule hairline.",
      "html": "<button class=\"ds-btn-secondary\">Cancelar</button>",
      "css": ".ds-btn-secondary{background:var(--paper);color:var(--ink);font-family:var(--font-sans);min-height:44px;padding:0 20px;font-size:1rem;border-radius:0;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:transform 150ms ease-out,background-color 150ms ease-out;border:1px solid var(--rule-strong)}.ds-btn-secondary:hover{background:var(--surface)}.ds-btn-secondary:active{transform:scale(0.98)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}@media (prefers-reduced-motion:reduce){.ds-btn-secondary{transition:none}}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Underlined text action with no visible border.",
      "html": "<button class=\"ds-btn-ghost\">Salir</button>",
      "css": ".ds-btn-ghost{background:var(--paper);color:var(--ink);font-family:var(--font-sans);min-height:44px;padding:0 20px;font-size:1rem;border-radius:0;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:transform 150ms ease-out,background-color 150ms ease-out;border:1px solid transparent;text-decoration:underline;text-underline-offset:4px}.ds-btn-ghost:hover{background:var(--surface)}.ds-btn-ghost:active{transform:scale(0.98)}.ds-btn-ghost:focus-visible{outline:2px solid var(--focus);outline-offset:2px}@media (prefers-reduced-motion:reduce){.ds-btn-ghost{transition:none}}"
    },
    {
      "name": "Añadir",
      "kind": "button",
      "refersTo": "add-action",
      "description": "The page's single floating primary action, fixed bottom right; the only shadow in the system.",
      "html": "<button class=\"ds-add\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M8 3v10M3 8h10\"/></svg>Añadir</button>",
      "css": ".ds-add{display:inline-flex;align-items:center;gap:8px;min-height:48px;padding:0 16px;background:var(--paper);color:var(--ink);border:2px solid var(--ink);border-bottom-width:4px;border-radius:0;font-family:var(--font-sans);font-stretch:75%;font-size:1.125rem;font-weight:700;box-shadow:0 6px 16px rgb(0 0 0/0.22);cursor:pointer;transition:transform 150ms ease-out,background-color 150ms ease-out}.ds-add:hover{background:var(--surface)}.ds-add:active{transform:scale(0.98)}.ds-add:focus-visible{outline:2px solid var(--focus);outline-offset:2px}@media (prefers-reduced-motion:reduce){.ds-add{transition:none}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Square 44px field on a Marked Rule hairline; label above.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Buscar</span><input class=\"ds-input\" placeholder=\"Título\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:var(--font-sans);color:var(--ink)}.ds-field-label{font-size:0.875rem;font-weight:500}.ds-input{min-height:44px;padding:0 12px;border:1px solid var(--rule-strong);border-radius:0;background:var(--paper);color:var(--ink);font-size:1rem;font-family:inherit}.ds-input::placeholder{color:var(--ink-muted)}.ds-input:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.ds-input[aria-invalid=true]{border:2px solid var(--state-urgent)}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "State filter; selected shows Pressed Paper, an ink hairline and a check.",
      "html": "<div style=\"display:flex;gap:8px\"><button class=\"ds-chip\" aria-pressed=\"true\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 8.5 6.2 11.7 13 4.8\"/></svg><span class=\"ds-sw\" style=\"background:var(--state-watched)\"></span>Vista</button><button class=\"ds-chip\" aria-pressed=\"false\"><span class=\"ds-sw\" style=\"background:var(--state-urgent)\"></span>Urgente</button></div>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;border:1px solid var(--rule-strong);border-radius:0;background:var(--paper);color:var(--ink);font-family:var(--font-sans);font-size:0.875rem;cursor:pointer;transition:transform 150ms ease-out,background-color 150ms ease-out}.ds-chip:hover{background:var(--surface)}.ds-chip:active{transform:scale(0.98)}.ds-chip[aria-pressed=true]{border-color:var(--ink);background:var(--surface);font-weight:600}.ds-chip:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.ds-sw{display:inline-block;width:14px;height:14px}"
    },
    {
      "name": "Average Box",
      "kind": "custom",
      "refersTo": "average-box",
      "description": "The only inverted element: the average reversed out of an ink box; an outlined dash when empty.",
      "html": "<span class=\"ds-avg\">7,63</span> <span class=\"ds-avg ds-avg-empty\">—</span>",
      "css": ".ds-avg{display:inline-flex;align-items:center;justify-content:center;min-width:48px;min-height:40px;padding:0 6px;background:var(--inverse-bg);color:var(--inverse-ink);font-family:var(--font-sans);font-size:1.25rem;font-weight:800;font-variant-numeric:tabular-nums}.ds-avg-empty{background:transparent;color:var(--ink-muted);border:1px solid var(--rule-strong)}"
    },
    {
      "name": "Critics' Table Row",
      "kind": "card",
      "refersTo": "critics-table-row",
      "description": "The signature row: condensed title, year and state cell, two tabular scores, verdict box.",
      "html": "<div class=\"ds-row\"><div><a class=\"ds-row-title\" href=\"#\">Perfect Days</a><div class=\"ds-row-meta\"><span>2023</span><span class=\"ds-sw\" style=\"background:var(--state-rewatch)\"></span><span>Repetir</span></div></div><span class=\"ds-num\">8,5</span><span class=\"ds-num\">7,75</span><span class=\"ds-avg\">8,13</span></div>",
      "css": ".ds-row{display:grid;grid-template-columns:minmax(0,1fr) 2.75rem 2.75rem 3rem;align-items:center;column-gap:8px;height:60px;padding:0 4px;border-bottom:1px solid var(--rule);background:var(--paper);color:var(--ink);font-family:var(--font-sans);transition:background-color 150ms}.ds-row:hover{background:var(--surface)}.ds-row:focus-within{outline:2px solid var(--focus);outline-offset:-2px}.ds-row-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-stretch:75%;font-size:1.0625rem;line-height:1.2;font-weight:700;color:inherit;text-decoration:none}.ds-row-title:focus-visible{outline:none}.ds-row-meta{display:flex;align-items:center;gap:8px;font-size:0.875rem;color:var(--ink-muted);font-variant-numeric:tabular-nums}.ds-sw{display:inline-block;width:14px;height:14px}.ds-num{text-align:center;font-variant-numeric:tabular-nums}.ds-avg{display:inline-flex;align-items:center;justify-content:center;min-width:48px;min-height:40px;padding:0 6px;background:var(--inverse-bg);color:var(--inverse-ink);font-family:var(--font-sans);font-size:1.25rem;font-weight:800;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "masthead",
      "description": "Condensed display title with its count on the baseline, closed by a 2px ink rule.",
      "html": "<div class=\"ds-mast\"><h1>Vistas</h1><span>276</span></div>",
      "css": ".ds-mast{display:flex;align-items:baseline;gap:12px;padding-bottom:8px;border-bottom:2px solid var(--ink);color:var(--ink);font-family:var(--font-sans)}.ds-mast h1{margin:0;font-stretch:75%;font-size:2.75rem;line-height:1;font-weight:800;letter-spacing:-0.025em}.ds-mast span{font-size:1.5rem;font-weight:600;color:var(--ink-muted);font-variant-numeric:tabular-nums}"
    }
